{% set sip_domain = trunk.domain if trunk.domain else trunk.registrar_host %}
{% set sip_port = trunk.port if trunk.port and trunk.port != 0 else 5060 %}
{% set transport = "transport-tls" if trunk.transport == "tls" else "transport-udp" %}
; Auto-generated by HA-Phone — do not edit manually
; Generated: {{ generated_at }}

[trunk-registration]
type = registration
outbound_auth = trunk-auth
server_uri = sip:{{ trunk.registrar_host }}:{{ sip_port }}
client_uri = sip:{{ trunk.auth_username }}@{{ sip_domain }}
contact_user = {{ trunk.auth_username }}
transport = {{ transport }}
retry_interval = 30
expiration = {{ trunk.reg_refresh }}
auth_rejection_permanent = no
outbound_proxy = sip:{{ trunk.registrar_host }}:{{ sip_port }}\;lr

[trunk-auth]
type = auth
auth_type = userpass
username = {{ trunk.auth_username }}
password = {{ trunk.password }}

[trunk-aor]
type = aor
contact = sip:{{ trunk.auth_username }}@{{ trunk.registrar_host }}:{{ sip_port }}
qualify_frequency = 60

[trunk-endpoint]
type = endpoint
context = from-trunk
disallow = all
allow = alaw,ulaw,g722
outbound_auth = trunk-auth
aors = trunk-aor
from_user = {{ trunk.auth_username }}
from_domain = {{ sip_domain }}
callerid = {{ trunk.phone_number }} <{{ trunk.phone_number }}>
; P-Asserted-Identity / P-Preferred-Identity für CLIP No Screening
send_pai = yes
send_rpid = yes
trust_id_inbound = yes
; NAT
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes

[trunk-identify]
type = identify
endpoint = trunk-endpoint
match = {{ trunk.registrar_host }}
