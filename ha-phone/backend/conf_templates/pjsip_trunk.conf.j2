{% set sip_domain = trunk.domain if trunk.domain else trunk.registrar_host %}
; Auto-generated by hassio-bpx — do not edit manually
; Generated: {{ generated_at }}

[dg-registration]
type = registration
outbound_auth = dg-auth
server_uri = sip:{{ trunk.registrar_host }}{% if trunk.port and trunk.port != 5060 %}:{{ trunk.port }}{% endif %}
client_uri = sip:{{ trunk.auth_username }}@{{ sip_domain }}
contact_user = {{ trunk.auth_username }}
transport = transport-udp
retry_interval = 30
expiration = {{ trunk.reg_refresh }}
auth_rejection_permanent = no

[dg-auth]
type = auth
auth_type = userpass
username = {{ trunk.auth_username }}
password = {{ trunk.password }}

[dg-aor]
type = aor
contact = sip:{{ trunk.auth_username }}@{{ sip_domain }}{% if trunk.port and trunk.port != 5060 %}:{{ trunk.port }}{% endif %}

[dg-endpoint]
type = endpoint
context = from-trunk
disallow = all
allow = alaw,ulaw,g722
outbound_auth = dg-auth
aors = dg-aor
from_user = {{ trunk.auth_username }}
from_domain = {{ sip_domain }}
callerid = {{ trunk.phone_number }} <{{ trunk.phone_number }}>

[dg-identify]
type = identify
endpoint = dg-endpoint
match = {{ trunk.registrar_host }}
