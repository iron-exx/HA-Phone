{% set sip_domain = trunk.domain if trunk.domain else trunk.registrar_host %}
{% set transport = "transport-tls" if trunk.transport == "tls" else "transport-udp" %}
{#
  server target: OMIT the port unless the user pinned a non-standard one.
  Providers like Deutsche Glasfaser publish _sip._udp SRV records (dg.voip.dg-w.de →
  sip10/sip20.voip.dg-w.de). PJSIP only performs SRV resolution when NO port is given;
  an explicit ":5060" forces the bare A record (185.22.44.186), which does NOT serve
  registration → "404 Fatal". A plain SIP device (e.g. a DECT base) omits the port and
  works. If SRV records are absent, PJSIP falls back to A + 5060 automatically, so
  omitting the port is the safe universal choice. Only pin a truly custom port.
#}
{% set server_target = (trunk.registrar_host ~ ":" ~ trunk.port) if (trunk.port and trunk.port != 0 and trunk.port != 5060) else trunk.registrar_host %}
{#
  Registration IDENTITY (AOR) vs AUTH credential are DIFFERENT on the aarenet/outbox
  platform (used by Deutsche Glasfaser as white-label, SBC "AareSwitch"):
    - auth username  = the SIP account from the provider letter (e.g. 30501827343)
    - AOR / From / Contact user = the PHONE NUMBER with leading 0 (e.g. 063483260104)
  Registering the AOR as the auth account returns "404 Not Found" after auth succeeds,
  because the registrar keys the AOR on the phone number, not the account. So the
  registration/from/contact user is the phone number; only [trunk-auth] uses the account.
#}
{% set reg_user = trunk.phone_number %}
; Auto-generated by HA-Phone — do not edit manually
; Generated: {{ generated_at }}

[trunk-registration]
type = registration
outbound_auth = trunk-auth
server_uri = sip:{{ server_target }}
client_uri = sip:{{ reg_user }}@{{ sip_domain }}
contact_user = {{ reg_user }}
transport = {{ transport }}
{#
  SELF-HEALING registration. With the stock defaults PJSIP permanently STOPS the
  outbound registration once it exhausts max_retries (default 10) consecutive
  failures — a "Maximum retries reached ... stopping registration attempt" and it
  never tries again until Asterisk reloads. A single transient provider/network
  blip (observed 2026-07-16: 10× "No response received" during an ~11-min DG
  outage) therefore takes the trunk down for days, killing all outbound/inbound
  calls while internal calls keep working. The knobs below keep it retrying:
    - max_retries very high        → never permanently give up on timeouts
    - fatal_retry_interval  > 0    → keep retrying after a "fatal" 4xx/5xx (e.g. 404)
    - forbidden_retry_interval > 0 → keep retrying after 403 Forbidden
    - auth_rejection_permanent = no → 401/407 auth failures are not permanent
#}
retry_interval = 60
forbidden_retry_interval = 60
fatal_retry_interval = 60
max_retries = 10000
expiration = {{ trunk.reg_refresh }}
auth_rejection_permanent = no

[trunk-auth]
type = auth
auth_type = userpass
username = {{ trunk.auth_username }}
password = {{ trunk.password }}

[trunk-aor]
type = aor
contact = sip:{{ server_target }}
qualify_frequency = 60

[trunk-endpoint]
type = endpoint
context = from-trunk
disallow = all
allow = {{ trunk.codecs if trunk.codecs else "ulaw,alaw" }}
outbound_auth = trunk-auth
aors = trunk-aor
from_user = {{ reg_user }}
from_domain = {{ sip_domain }}
; CallerID in E.164 → drives the P-Asserted-Identity so the callee actually sees
; the number (CLIP). The From-URI user stays the registered (national) identity.
callerid = {{ caller_e164 }} <{{ caller_e164 }}>
; P-Asserted-Identity / P-Preferred-Identity für CLIP No Screening
send_pai = yes
send_rpid = yes
trust_id_inbound = yes
; NAT — Asterisk stays in the media path; direct media LAN<->CGNAT drops the call
direct_media = no
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes

[trunk-identify]
type = identify
endpoint = trunk-endpoint
match = {{ trunk.registrar_host }}
