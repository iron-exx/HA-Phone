{% set sip_domain = trunk.domain if trunk.domain else trunk.registrar_host %}
{% set transport = "transport-tls" if trunk.transport == "tls" else "transport-udp" %}
{#
  server target: OMIT the port unless the user pinned a non-standard one.
  Providers like Deutsche Glasfaser publish _sip._udp SRV records (dg.voip.dg-w.de →
  sip10/sip20.voip.dg-w.de). PJSIP only performs SRV resolution when NO port is given;
  an explicit ":5060" forces the bare A record (185.22.44.186), which does NOT serve
  registration → "404 Fatal". A plain SIP device (e.g. a DECT base) omits the port and
  works. If SRV records are absent, PJSIP falls back to A + 5060 automatically, so
  omitting the port is the safe universal choice. Only pin a truly custom port.
#}
{% set server_target = (trunk.registrar_host ~ ":" ~ trunk.port) if (trunk.port and trunk.port != 0 and trunk.port != 5060) else trunk.registrar_host %}
; Auto-generated by HA-Phone — do not edit manually
; Generated: {{ generated_at }}

[trunk-registration]
type = registration
outbound_auth = trunk-auth
server_uri = sip:{{ server_target }}
client_uri = sip:{{ trunk.auth_username }}@{{ sip_domain }}
transport = {{ transport }}
retry_interval = 30
expiration = {{ trunk.reg_refresh }}
auth_rejection_permanent = no

[trunk-auth]
type = auth
auth_type = userpass
username = {{ trunk.auth_username }}
password = {{ trunk.password }}

[trunk-aor]
type = aor
contact = sip:{{ server_target }}
qualify_frequency = 60

[trunk-endpoint]
type = endpoint
context = from-trunk
disallow = all
allow = alaw,ulaw,g722
outbound_auth = trunk-auth
aors = trunk-aor
from_user = {{ trunk.auth_username }}
from_domain = {{ sip_domain }}
callerid = {{ trunk.phone_number }} <{{ trunk.phone_number }}>
; P-Asserted-Identity / P-Preferred-Identity für CLIP No Screening
send_pai = yes
send_rpid = yes
trust_id_inbound = yes
; NAT
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes

[trunk-identify]
type = identify
endpoint = trunk-endpoint
match = {{ trunk.registrar_host }}
