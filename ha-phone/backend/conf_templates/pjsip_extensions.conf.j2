; Auto-generated by hassio-bpx FastAPI backend — do not edit manually
; Generated: {{ generated_at }}

{% for ext in extensions %}
; --- Extension {{ ext.number }} ({{ ext.display_name }}) ---
[{{ ext.number }}]
type              = endpoint
context           = {% if ext.video_capable %}doorbell-out{% else %}internal{% endif %}

disallow          = all
allow             = alaw,ulaw,g722
{% if ext.video_capable %}
allow             = h264
max_video_streams = 1
direct_media      = no
{% else %}
max_video_streams = 0
{% endif %}
auth              = {{ ext.number }}-auth
aors              = {{ ext.number }}-aors
callerid          = {{ ext.display_name }} <{{ ext.number }}>

[{{ ext.number }}-auth]
type              = auth
auth_type         = userpass
username          = {{ ext.number }}
password          = {{ ext.sip_password }}

[{{ ext.number }}-aors]
type              = aor
{% if ext.video_capable %}
max_contacts      = 1
remove_existing   = yes
{% else %}
max_contacts      = 2
{% endif %}

{% endfor %}
