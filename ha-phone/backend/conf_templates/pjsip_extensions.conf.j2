; Auto-generated by hassio-bpx FastAPI backend — do not edit manually
; Generated: {{ generated_at }}

{% for ext in extensions if ext.enabled %}
; --- Extension {{ ext.number }} ({{ ext.display_name }}) ---
[{{ ext.number }}]
type              = endpoint
context           = {% if ext.internal_only %}from-internal-restricted{% else %}from-internal{% endif %}

disallow          = all
allow             = alaw,ulaw,g722
{% if ext.video_capable %}
allow             = h264
max_video_streams = 1
{% else %}
max_video_streams = 0
{% endif %}
; Keep Asterisk in the media path — direct media between a LAN softphone and a
; NAT/CGNAT trunk cannot work and drops the call on answer.
direct_media      = no
rtp_symmetric     = yes
force_rport       = yes
rewrite_contact   = yes
; Asterisk 22 anonymizes the From header on Dial()-created legs ("Anonymous"
; <sip:anonymous@anonymous.invalid>) unless the callee endpoint trusts the
; caller identity outbound - every internal call then shows "anonymous", and
; Linphone iOS/CallKit may not even display the incoming-call UI for the
; invalid anonymous URI. All extensions are our own trusted endpoints, so
; always send the real caller id (verified live via pjsip logger).
trust_id_outbound = yes
; trust_id_outbound alone only controls whether a REAL identity is revealed
; to the destination - it does nothing if the calling channel never had one
; to begin with. A call placed BY this extension (e.g. a door intercom
; dialling a ring group) only gets CALLERID(num)/(name) populated from its
; own INVITE if Asterisk actually trusts/accepts that identity as the
; SOURCE - which is trust_id_inbound, not trust_id_outbound. Without it, the
; calling leg's caller id stays blank and every Dial()-created leg past it
; (e.g. into a ring group) falls back to "Anonymous", confirmed live via a
; SIP capture of exactly that call path (door intercom -> ring group).
trust_id_inbound  = yes
auth              = {{ ext.number }}-auth
aors              = {{ ext.number }}
callerid          = {{ ext.display_name }} <{{ ext.number }}>

[{{ ext.number }}-auth]
type              = auth
auth_type         = userpass
username          = {{ ext.number }}
password          = {{ ext.sip_password }}

; AOR name MUST equal the SIP username: the inbound registrar (res_pjsip_registrar.c
; find_registrar_aor) looks up the AOR by the REGISTER's To-user against endpoint->aors,
; so an AOR named "<number>-aors" never matches user "<number>" → "AOR '' not found".
[{{ ext.number }}]
type              = aor
{% if ext.video_capable %}
max_contacts      = 1
remove_existing   = yes
{% else %}
max_contacts      = 2
{% endif %}

{% endfor %}
