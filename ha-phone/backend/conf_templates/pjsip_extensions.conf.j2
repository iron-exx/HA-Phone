; Auto-generated by hassio-bpx FastAPI backend — do not edit manually
; Generated: {{ generated_at }}

{% for ext in extensions if ext.enabled %}
; --- Extension {{ ext.number }} ({{ ext.display_name }}) ---
[{{ ext.number }}]
type              = endpoint
; Internal-only endpoints get a per-extension context so the dialplan can
; force the configured display_name/number as caller ID before routing.
; Many door intercoms send Anonymous in their From header; trust_id_inbound
; faithfully forwards that — the per-extension context overrides it explicitly.
context           = {% if ext.internal_only %}from-restricted-{{ ext.number }}{% else %}from-internal{% endif %}

disallow          = all
allow             = alaw,ulaw,g722
; German prompts (voicemail, *97) from sounds/de; Asterisk falls back to English per file.
language          = de
{% if ext.video_capable %}
allow             = h264
max_video_streams = 1
{% else %}
max_video_streams = 0
{% endif %}
; Keep Asterisk in the media path — direct media between a LAN softphone and a
; NAT/CGNAT trunk cannot work and drops the call on answer.
direct_media      = no
rtp_symmetric     = yes
force_rport       = yes
rewrite_contact   = yes
; Asterisk 22 anonymizes the From header on Dial()-created legs ("Anonymous"
; <sip:anonymous@anonymous.invalid>) unless the callee endpoint trusts the
; caller identity outbound - every internal call then shows "anonymous", and
; Linphone iOS/CallKit may not even display the incoming-call UI for the
; invalid anonymous URI. All extensions are our own trusted endpoints, so
; always send the real caller id (verified live via pjsip logger).
trust_id_outbound = yes
; trust_id_outbound alone only controls whether a REAL identity is revealed
; to the destination - it does nothing if the calling channel never had one
; to begin with. A call placed BY this extension (e.g. a door intercom
; dialling a ring group) only gets CALLERID(num)/(name) populated from its
; own INVITE if Asterisk actually trusts/accepts that identity as the
; SOURCE - which is trust_id_inbound, not trust_id_outbound. Without it, the
; calling leg's caller id stays blank and every Dial()-created leg past it
; (e.g. into a ring group) falls back to "Anonymous", confirmed live via a
; SIP capture of exactly that call path (door intercom -> ring group).
trust_id_inbound  = yes
; Gigaset DECT bases (N510/N720 etc.) don't reliably show a caller NAME from a
; plain From header alone — confirmed live via SIP capture: the From header
; carried a correct "name" <number> for an internal call, yet the handset
; still displayed "Anonymous". Send P-Asserted-Identity / Remote-Party-ID too,
; same as already done for the trunk endpoint (CLIP), so the phone has an
; identity source it actually trusts for internal caller ID.
send_pai          = yes
send_rpid         = yes
auth              = {{ ext.number }}-auth
aors              = {{ ext.number }}
callerid          = {{ ext.display_name }} <{{ ext.number }}>
; Message-waiting indication (res_pjsip_mwi) for the extension's own voicemail box.
mailboxes         = {{ ext.number }}@default
{#
  No media_encryption: res_srtp is not built into the image (menuselect
  --disable-all without --enable res_srtp), so 'sdes'/'dtls' would make the
  endpoint fail to load. Legacy DB values (sdes/dtls) therefore render as the
  default (no SRTP); the API only accepts 'none'.
#}

[{{ ext.number }}-auth]
type              = auth
auth_type         = userpass
username          = {{ ext.number }}
password          = {{ ext.sip_password }}

; AOR name MUST equal the SIP username: the inbound registrar (res_pjsip_registrar.c
; find_registrar_aor) looks up the AOR by the REGISTER's To-user against endpoint->aors,
; so an AOR named "<number>-aors" never matches user "<number>" → "AOR '' not found".
[{{ ext.number }}]
type              = aor
; OPTIONS every 60 s: keeps the TLS connection open through NAT/routers, so the app stays
; reachable for days without calls, and the PBX notices a phone that is really gone.
qualify_frequency = 60
qualify_timeout   = 5
{% if ext.video_capable %}
; Video extensions (door-station preview): exactly ONE contact. The pre-answer video
; preview relies on callee-side 183 early media to a single target — with several
; contacts forked, the door station's H.264 early media can only reach one of them
; (same reason ring groups with >1 target lose the preview). A re-register replaces
; the old contact instead of being rejected.
max_contacts      = 1
remove_existing   = yes
{% else %}
; Multi-device: desk phone + app + softphone on the same extension. The dialplan
; rings all of them via PJSIP_DIAL_CONTACTS(); the oldest contact is replaced when
; a 4th device registers, and unreachable contacts are dropped by qualify.
max_contacts      = 3
remove_existing   = yes
remove_unavailable = yes
{% endif %}

{% endfor %}
