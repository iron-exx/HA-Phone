# Auto-generated by HA-Phone — do not edit manually
# msmtp relay used by Asterisk voicemail to send mail via the configured SMTP server.
account default
host {{ host }}
port {{ port }}
from {{ from_addr }}
{% if encryption == "ssl" %}
tls on
tls_starttls off
{% elif encryption == "starttls" %}
tls on
tls_starttls on
{% else %}
tls off
{% endif %}
{% if username %}
auth on
user {{ username }}
password {{ password }}
{% else %}
auth off
{% endif %}
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /data/logs/msmtp.log
