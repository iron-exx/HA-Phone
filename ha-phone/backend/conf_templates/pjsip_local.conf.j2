; Auto-generated by HA-Phone (backend/pjsip_local.py) — do not edit manually
; Written on every boot by cont-init.d/10-asterisk-init.sh and by the web UI
; (Einstellungen -> Öffentliche IP). BOTH paths render this one template, so saving
; the public IP can no longer drop the TLS transport stanza.
; Generated: {{ generated_at }}
{% macro local_nets() %}
local_net                  = 192.168.0.0/16
local_net                  = 10.0.0.0/8
local_net                  = 172.16.0.0/12
; Tailscale/WireGuard VPN range — treat remote softphones on the VPN as local so
; RTP goes straight over the tunnel (no external_media_address rewrite → clean audio).
local_net                  = 100.64.0.0/10
local_net                  = fd7a:115c:a1e0::/48
{% endmacro %}
{% if not ip %}
; External IP detection failed / not set — Asterisk runs in LAN-only mode.
; Restart the add-on to retry detection or set it in the web UI.
{% endif %}

[transport-udp](+)
{% if ip and not ip_is_v6 %}
external_signaling_address = {{ ip }}
external_media_address     = {{ ip }}
{% endif %}
{{ local_nets()|safe }}
{% if ip and ip_is_v6 %}
; IPv6 external address ONLY on the IPv6 transport — on the IPv4 transport it would
; rewrite IPv4 Contact/SDP to an IPv6 address the peer cannot reach.
[transport-udp-ipv6](+)
external_signaling_address = {{ ip }}
external_media_address     = {{ ip }}
{% endif %}
{% if tls %}

[transport-tls]
type       = transport
protocol   = tls
bind       = 0.0.0.0:5061
cert_file  = {{ tls_cert }}
priv_key_file = {{ tls_key }}
method     = tlsv1_2
{% if ip and not ip_is_v6 %}
external_signaling_address = {{ ip }}
external_media_address     = {{ ip }}
{% endif %}
{{ local_nets()|safe }}
{% endif %}
