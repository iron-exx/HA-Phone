; Auto-generated by HA-Phone - do not edit manually
; Generated: {{ generated_at }}
; Contexts: from-internal, from-internal-restricted, outbound-pstn, from-trunk, ivr-*, doorbell-out, ext-*

{#
  Shared "destination action" - same 5-way branch already used for Route/
  TimeCondition (ring_group/ivr targets by DB id, extension/voicemail targets
  by number), reused here for presence-forwarding destinations so there is
  only one place that knows how to render each dest_type.
#}
{% macro dest_action(dest_type, dest_target) %}
{% if dest_type == 'ring_group' %}
{% if ring_group_dials.get(dest_target, '') %}
 same => n,Dial({{ ring_group_dials.get(dest_target, '') }},30)
{% else %}
 same => n,Congestion()
{% endif %}
 same => n,Hangup()
{% elif dest_type == 'ivr' %}
 same => n,Goto(ivr-{{ dest_target }},s,1)
{% elif dest_type == 'voicemail' %}
 same => n,Voicemail({{ dest_target }}@default,u)
 same => n,Hangup()
{% elif dest_type == 'hangup' %}
 same => n,Hangup()
{% else %}
 same => n,Dial(PJSIP/{{ dest_target }},30)
 same => n,Voicemail({{ dest_target }}@default,u)
 same => n,Hangup()
{% endif %}
{% endmacro %}

; Internal calls + outbound dial rules
[from-internal]

; Internal IVR menus - explicit entries win before ring groups and generic pattern.
{% for ivr_menu in ivr_menus %}
{% if ivr_menu.number %}
exten => {{ ivr_menu.number }},1,NoOp(Internal IVR {{ ivr_menu.name }})
 same => n,Goto(ivr-{{ ivr_menu.id }},s,1)
{% endif %}
{% endfor %}

; Internal ring groups - explicit entries win before the generic 2-digit extension pattern.
{% for ring_group in ring_groups %}
{% if ring_group.number and ring_group_dials.get(ring_group.id, '') %}
exten => {{ ring_group.number }},1,NoOp(Internal ring group {{ ring_group.name }})
 same => n,Dial({{ ring_group_dials.get(ring_group.id, '') }},{{ ring_group.ring_timeout }})
 same => n,Hangup()
{% endif %}
{% endfor %}

; Legacy-device extensions (Altgeraete-Modus): old SIP clients like Android's
; discontinued native stack reject non-numeric caller display names and show
; "Anonymous". Explicit entries win over the generic _XX pattern below and
; rewrite the caller name to the bare number before dialling.
{% for ext in extensions %}
{% if ext.numeric_callerid and ext.enabled %}
exten => {{ ext.number }},1,NoOp(Internal call to {{ ext.number }} (numeric caller id))
 same => n,Set(CALLERID(name)=${CALLERID(num)})
 same => n,Dial(PJSIP/{{ ext.number }},30)
 same => n,Voicemail({{ ext.number }}@default,u)
 same => n,Hangup()
{% endif %}
{% endfor %}

; Internal 2-digit extensions (scheme 10-99) - never routed to the trunk.
; Presence-based forwarding (if configured for the callee's current status)
; happens inside ext-${EXTEN} - this just tags the call as internal-direction
; before landing there.
exten => _XX,1,NoOp(Internal call to ${EXTEN})
 same => n,Set(CALL_DIRECTION=internal)
 same => n,Goto(ext-${EXTEN},s,1)

; Outbound dial rules (editable in the web UI -> Routing -> Ausgehende Regeln).
; Each rule strips `strip` leading digits and prepends `prepend`, then routes to
; the SIP trunk. Evaluated by Asterisk pattern specificity; ordered by priority.
{% for rule in outbound_rules %}
exten => _{{ rule.pattern }},1,NoOp(Outbound rule '{{ rule.pattern }}' strip {{ rule.strip }} prepend '{{ rule.prepend }}': ${EXTEN})
 same => n,Set(CALLNUM={{ rule.prepend }}${EXTEN:{{ rule.strip }}})
 same => n,Set(OUTBOUND_CID={{ outbound_rule_cid.get(rule.id, '') }})
 same => n,Goto(outbound-pstn,${CALLNUM},1)
{% endfor %}
{% if not outbound_rules %}
; No outbound rules configured - nothing can be dialled externally yet.
{% endif %}

exten => i,1,NoOp(Invalid number: ${EXTEN})
 same => n,Playback(ss-noservice)
 same => n,Hangup()

exten => t,1,NoOp(Timeout: ${EXTEN})
 same => n,Hangup()

