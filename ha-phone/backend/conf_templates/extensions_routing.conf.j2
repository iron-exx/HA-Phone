; Auto-generated by HA-Phone — do not edit manually
; Generated: {{ generated_at }}
; Contexts: from-internal, outbound-pstn, from-trunk

; ── Internal calls + outbound normalization ─────────────────────────────────
[from-internal]

; Internal 2-digit extensions (scheme 10–19, never routed to trunk)
exten => _1X,1,NoOp(Internal call to ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN},30)
 same => n,Voicemail(${EXTEN}@default,u)
 same => n,Hangup()

; E.164 normalization — more-specific prefix patterns win
exten => _0049.,1,Set(DIALNUM=+${EXTEN:4})
 same => n,Goto(outbound-pstn,${DIALNUM},1)

exten => _00.,1,Set(DIALNUM=+${EXTEN:2})
 same => n,Goto(outbound-pstn,${DIALNUM},1)

exten => _0.,1,Set(DIALNUM=+49${EXTEN:1})
 same => n,Goto(outbound-pstn,${DIALNUM},1)

exten => _+.,1,Set(DIALNUM=${EXTEN})
 same => n,Goto(outbound-pstn,${DIALNUM},1)

exten => i,1,NoOp(Invalid extension: ${EXTEN})
 same => n,Congestion()
 same => n,Hangup()

exten => t,1,NoOp(Timeout for extension: ${EXTEN})
 same => n,Congestion()
 same => n,Hangup()

; ── Outbound PSTN via SIP trunk ───────────────────────────────────────────────
[outbound-pstn]
exten => _+.,1,NoOp(Outbound PSTN via SIP trunk: ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN}@trunk-endpoint,60)
 same => n,Congestion()
 same => n,Hangup()

; ── Inbound PSTN from SIP trunk ───────────────────────────────────────────────
[from-trunk]
{% for condition in time_conditions %}
exten => {{ condition.did }},1,NoOp(Inbound: {{ condition.did }})
 same => n,GotoIfTime({{ condition.open_hours_start }}-{{ condition.open_hours_end }}|*|*|{{ condition.open_days }}?open-{{ condition.id }},1,1:closed-{{ condition.id }},1,1)

{% endfor %}
{% if time_conditions | length == 0 %}
; No time conditions — ring all configured extensions, fallthrough to voicemail
exten => _X.,1,NoOp(Inbound PSTN: ${EXTEN})
 same => n,Dial(PJSIP/ext10&PJSIP/ext11&PJSIP/ext12,30)
 same => n,Voicemail(10@default,u)
 same => n,Hangup()
{% endif %}
{% for condition in time_conditions %}

[open-{{ condition.id }}]
exten => 1,1,Dial(PJSIP/ext{{ condition.open_destination }},30)
 same => n,Voicemail({{ condition.open_destination }}@default,u)
 same => n,Hangup()

[closed-{{ condition.id }}]
exten => 1,1,Voicemail({{ condition.closed_destination }}@default,u)
 same => n,Hangup()
{% endfor %}


; ── Doorbell ring-all contexts ────────────────────────────────────────────
{% for rg in ring_groups %}
[doorbell-out]
; Ring group: {{ rg.name }} — rings {{ rg.extension_numbers }} simultaneously
exten => _X.,1,NoOp(Doorbell ring: ${EXTEN})
 same => n,Dial({{ ring_group_dials[rg.id] }},{{ rg.ring_timeout }})
 same => n,Hangup()

{% endfor %}
{% if not ring_groups %}
; [doorbell-out] not rendered — no ring groups configured
{% endif %}