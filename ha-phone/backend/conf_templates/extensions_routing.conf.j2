  extension NUMBER (there is no separate "id" concept for extensions in the
  dialplan - PJSIP/{number} is always the dialable identifier).
#}
{% for condition in time_conditions %}

[open-{{ condition.id }}]
{% if condition.open_dest_type == 'ring_group' %}
{% if ring_group_dials.get(condition.open_destination, '') %}
exten => 1,1,Dial({{ ring_group_dials.get(condition.open_destination, '') }},30)
{% else %}
exten => 1,1,Congestion()
{% endif %}
 same => n,Hangup()
{% elif condition.open_dest_type == 'ivr' %}
exten => 1,1,Goto(ivr-{{ condition.open_destination }},s,1)
{% elif condition.open_dest_type == 'voicemail' %}
exten => 1,1,Voicemail({{ condition.open_destination }}@default,u)
 same => n,Hangup()
{% elif condition.open_dest_type == 'hangup' %}
exten => 1,1,Hangup()
{% else %}
exten => 1,1,Set(CALL_DIRECTION=external)
 same => n,Goto(ext-{{ condition.open_destination }},s,1)
