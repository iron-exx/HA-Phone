; Auto-generated by HA-Phone - do not edit manually
; Generated: {{ generated_at }}
; Contexts: from-internal, from-internal-restricted, outbound-pstn, from-trunk, ivr-*, doorbell-out

; Internal calls + outbound dial rules
[from-internal]

; Internal IVR menus - explicit entries win before ring groups and generic pattern.
{% for ivr_menu in ivr_menus %}
{% if ivr_menu.number %}
exten => {{ ivr_menu.number }},1,NoOp(Internal IVR {{ ivr_menu.name }})
 same => n,Goto(ivr-{{ ivr_menu.id }},s,1)
{% endif %}
{% endfor %}

; Internal ring groups - explicit entries win before the generic 2-digit extension pattern.
{% for ring_group in ring_groups %}
{% if ring_group.number and ring_group_dials.get(ring_group.id, '') %}
exten => {{ ring_group.number }},1,NoOp(Internal ring group {{ ring_group.name }})
 same => n,Dial({{ ring_group_dials.get(ring_group.id, '') }},{{ ring_group.ring_timeout }})
 same => n,Hangup()
{% endif %}
{% endfor %}

; Internal 2-digit extensions (scheme 10-99) - never routed to the trunk
exten => _XX,1,NoOp(Internal call to ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN},30)
 same => n,Voicemail(${EXTEN}@default,u)
 same => n,Hangup()

; Outbound dial rules (editable in the web UI -> Routing -> Ausgehende Regeln).
; Each rule strips `strip` leading digits and prepends `prepend`, then routes to
; the SIP trunk. Evaluated by Asterisk pattern specificity; ordered by priority.
{% for rule in outbound_rules %}
exten => _{{ rule.pattern }},1,NoOp(Outbound rule '{{ rule.pattern }}' strip {{ rule.strip }} prepend '{{ rule.prepend }}': ${EXTEN})
 same => n,Set(CALLNUM={{ rule.prepend }}${EXTEN:{{ rule.strip }}})
 same => n,Goto(outbound-pstn,${CALLNUM},1)
{% endfor %}
{% if not outbound_rules %}
; No outbound rules configured - nothing can be dialled externally yet.
{% endif %}

exten => i,1,NoOp(Invalid number: ${EXTEN})
 same => n,Playback(ss-noservice)
 same => n,Hangup()

exten => t,1,NoOp(Timeout: ${EXTEN})
 same => n,Hangup()

; Internal-only endpoints (e.g. door intercom) - NO outbound to the trunk
[from-internal-restricted]
{% for ivr_menu in ivr_menus %}
{% if ivr_menu.number %}
exten => {{ ivr_menu.number }},1,NoOp(Internal-only IVR {{ ivr_menu.name }})
 same => n,Goto(ivr-{{ ivr_menu.id }},s,1)
{% endif %}
{% endfor %}
{% for ring_group in ring_groups %}
{% if ring_group.number and ring_group_dials.get(ring_group.id, '') %}
exten => {{ ring_group.number }},1,NoOp(Internal-only call to ring group {{ ring_group.name }})
 same => n,Dial({{ ring_group_dials.get(ring_group.id, '') }},{{ ring_group.ring_timeout }})
 same => n,Hangup()
{% endif %}
{% endfor %}
exten => _XX,1,NoOp(Internal-only call to ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN},30)
 same => n,Voicemail(${EXTEN}@default,u)
 same => n,Hangup()
exten => _X.,1,NoOp(Blocked external dial from internal-only endpoint: ${EXTEN})
 same => n,Playback(ss-noservice)
 same => n,Hangup()
exten => _+X.,1,NoOp(Blocked external dial from internal-only endpoint: ${EXTEN})
 same => n,Playback(ss-noservice)
 same => n,Hangup()
exten => i,1,Hangup()
exten => t,1,Hangup()

; Outbound PSTN via SIP trunk
[outbound-pstn]
exten => _X.,1,NoOp(Outbound via SIP trunk: ${EXTEN})
{% if trunk_callerid %} same => n,Set(CALLERID(all)={{ trunk_callerid }} <{{ trunk_callerid }}>)
{% endif %} same => n,Dial(PJSIP/${EXTEN}@trunk-endpoint,60)
 same => n,Congestion()
 same => n,Hangup()

; Inbound PSTN from SIP trunk
[from-trunk]
{% for route in routes %}
{% for did in route_dids[route.id] %}
exten => {{ did }},1,NoOp(Inbound {{ did }} -> {{ route.destination_type }}:{{ route.destination_id }})
{% if route.destination_type == 'ring_group' %}
{% if ring_group_dials.get(route.destination_id, '') %}
 same => n,Dial({{ ring_group_dials.get(route.destination_id, '') }},30)
{% else %}
 same => n,Congestion()
{% endif %}
{% elif route.destination_type == 'ivr' %}
 same => n,Goto(ivr-{{ route.destination_id }},s,1)
{% else %}
 same => n,Dial(PJSIP/{{ route.destination_id }},30)
 same => n,Voicemail({{ route.destination_id }}@default,u)
{% endif %}
 same => n,Hangup()
{% endfor %}
{% endfor %}
{% for condition in time_conditions %}
exten => {{ condition.did }},1,NoOp(Inbound (time): {{ condition.did }})
 same => n,GotoIfTime({{ condition.open_hours_start }}-{{ condition.open_hours_end }}|*|*|{{ condition.open_days }}?open-{{ condition.id }},1,1:closed-{{ condition.id }},1,1)
{% endfor %}
{% if not routes and not time_conditions %}
; No inbound routes/time conditions - ring all enabled extensions, then hang up.
exten => _X.,1,NoOp(Inbound (fallback): ${EXTEN})
{% if all_ext_dial %} same => n,Dial({{ all_ext_dial }},30)
{% else %} same => n,Congestion()
{% endif %} same => n,Hangup()
exten => _+X.,1,NoOp(Inbound (fallback +): ${EXTEN})
{% if all_ext_dial %} same => n,Dial({{ all_ext_dial }},30)
{% else %} same => n,Congestion()
{% endif %} same => n,Hangup()
{% endif %}
{% for condition in time_conditions %}

[open-{{ condition.id }}]
exten => 1,1,Dial(PJSIP/{{ condition.open_destination }},30)
 same => n,Voicemail({{ condition.open_destination }}@default,u)
 same => n,Hangup()

[closed-{{ condition.id }}]
exten => 1,1,Voicemail({{ condition.closed_destination }}@default,u)
 same => n,Hangup()
{% endfor %}

; IVR menus (Interactive Voice Response / Digitaler Empfang)
{% for ivr_menu in ivr_menus %}
[ivr-{{ ivr_menu.id }}]
; `s` is the real entry point and initializes the invalid-attempt counter exactly
; once. Replays after an invalid entry jump to `menu` instead of back to `s` — the
; old code went back to `s`, which reset IVR_INVALID_COUNT to 0 on every replay, so
; `max_invalid_tries` could never be reached (infinite reprompt loop, never hangs up).
exten => s,1,Answer()
 same => n,Set(IVR_INVALID_COUNT=0)
 same => n,Goto(menu,1)
exten => menu,1,NoOp(IVR {{ ivr_menu.name }})
{% if ivr_menu.greeting_file %}
 same => n,Set(TIMEOUT(digit)=5)
 same => n,Background({{ ivr_sounds_dir }}/{{ ivr_menu.greeting_file }})
{% else %}
 same => n,Set(TIMEOUT(digit)={{ ivr_menu.timeout }})
{% endif %}
 same => n,WaitExten({{ ivr_menu.timeout }})
{% for opt in ivr_menu.parsed_options %}
{% if opt.action == 'extension' %}
exten => {{ opt.key }},1,Goto(from-internal,{{ opt.target }},1)
{% elif opt.action == 'ring_group' %}
exten => {{ opt.key }},1,Goto(from-internal,{{ opt.target }},1)
{% elif opt.action == 'voicemail' %}
exten => {{ opt.key }},1,Voicemail({{ opt.target }}@default,u)
 same => n,Hangup()
{% elif opt.action == 'hangup' %}
exten => {{ opt.key }},1,Hangup()
{% endif %}
{% endfor %}
exten => i,1,Set(IVR_INVALID_COUNT=$[${IVR_INVALID_COUNT} + 1])
{% if ivr_menu.max_invalid_tries > 0 %}
 same => n,GotoIf($[${IVR_INVALID_COUNT} >= {{ ivr_menu.max_invalid_tries }}]?t,1)
{% endif %}
 same => n,Playback(pbx-invalid)
 same => n,Goto(menu,1)
exten => t,1,Hangup()
{% endfor %}

; Doorbell ring-all context
[doorbell-out]
exten => _X.,1,NoOp(Doorbell ring: ${EXTEN})
{% if doorbell_dial %}
 same => n,Dial({{ doorbell_dial }},30)
{% else %}
 same => n,Congestion()
{% endif %}
 same => n,Hangup()
