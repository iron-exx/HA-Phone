{#
  Per-extension landing context - every call path that resolves to "dial this
  specific extension" (the internal _XX pattern, a Route/TimeCondition with an
  "extension" destination, an IVR option with action "extension") Goto()s here
  instead of Dial()ing PJSIP/{number} directly, after Set()ing CALL_DIRECTION.
  This is where presence-based forwarding (Extension.presence_status +
  PresenceForwardingRule) takes effect. Ring groups are NOT routed through
  here - simultaneous-ring to multiple endpoints doesn't have a single
  "the callee" to forward, so presence forwarding only applies to direct
  single-extension targeting.

  presence_status is resolved once per regeneration (not a live per-call
  lookup) - each entry's internal/external landing is precomputed in Python
  (time_conditions.py) from the extension's CURRENT status, so a status
  change takes effect the next time the dialplan is regenerated (immediately,
  since changing it via the UI triggers a regen the same way every other
  setting does). Entries are generated for every NUMBER referenced as an
  "extension"-type destination anywhere, not just numbers with a real
  Extension row (see ext_landing_entries in time_conditions.py) - so a Goto()
  here always finds a context, even for a dangling reference to a deleted
  extension (falls back to the same default behavior a direct Dial() to a
  nonexistent PJSIP endpoint would have had).
#}
{% for entry in ext_landing_entries %}
[ext-{{ entry.number }}]
exten => s,1,NoOp(Landing for {{ entry.number }} ({{ entry.display_name }}) - presence: {{ entry.presence_status }})
 same => n,GotoIf($["${CALL_DIRECTION}" = "external"]?external,1:internal,1)

{% set internal = entry.internal %}
exten => internal,1,NoOp(Internal call to {{ entry.number }})
{% if internal.mode == 'always_dest' %}
{{ dest_action(internal.dest_type, internal.dest_target) }}
{% elif internal.mode == 'ring_then_dest' %}
 same => n,Dial(PJSIP/{{ entry.number }},{{ internal.ring_timeout }})
{{ dest_action(internal.dest_type, internal.dest_target) }}
{% else %}
 same => n,Dial(PJSIP/{{ entry.number }},30)
 same => n,Voicemail({{ entry.number }}@default,u)
 same => n,Hangup()
{% endif %}

{% set external = entry.external %}
exten => external,1,NoOp(External call to {{ entry.number }})
{% if external.mode == 'always_dest' %}
{{ dest_action(external.dest_type, external.dest_target) }}
{% elif external.mode == 'ring_then_dest' %}
 same => n,Dial(PJSIP/{{ entry.number }},{{ external.ring_timeout }})
{{ dest_action(external.dest_type, external.dest_target) }}
{% else %}
 same => n,Dial(PJSIP/{{ entry.number }},30)
 same => n,Voicemail({{ entry.number }}@default,u)
 same => n,Hangup()
{% endif %}
{% endfor %}

; Outbound PSTN via SIP trunk
; OUTBOUND_CID is set by the per-rule block above - either the outbound rule's
; own CID override (a specific trunk DID) or, if unset, the trunk's default
; phone_number (both already normalized to E.164 in Python - see
; outbound_rule_cid in time_conditions.py). The only other way into this
; context is the _+X. re-entry rule below, on the same channel, where
; OUTBOUND_CID is already set from the original rule.
[outbound-pstn]
exten => _X.,1,NoOp(Outbound via SIP trunk: ${EXTEN})
{% if trunk_callerid %} same => n,Set(CALLERID(all)=${OUTBOUND_CID} <${OUTBOUND_CID}>)
{% endif %} same => n,Dial(PJSIP/${EXTEN}@trunk-endpoint,60)
 same => n,Congestion()
 same => n,Hangup()
; Outbound rules can prepend "+" (E.164, e.g. for German numbers rewritten to
; +49...) before Goto()-ing here. `X` in an Asterisk pattern matches digits
; only, never "+", so strip the prefix once and re-enter the same context.
exten => _+X.,1,NoOp(Outbound via SIP trunk (E.164): ${EXTEN})
 same => n,Goto(outbound-pstn,${EXTEN:1},1)

; Inbound PSTN from SIP trunk
[from-trunk]
{% for route in routes %}
{% for did in route_dids[route.id] %}
exten => {{ did }},1,NoOp(Inbound {{ did }} -> {{ route.destination_type }}:{{ route.destination_id }})
{% if route.destination_type == 'ring_group' %}
{% if ring_group_dials.get(route.destination_id, '') %}
 same => n,Dial({{ ring_group_dials.get(route.destination_id, '') }},30)
{% else %}
 same => n,Congestion()
{% endif %}
{% elif route.destination_type == 'ivr' %}
 same => n,Goto(ivr-{{ route.destination_id }},s,1)
{% elif route.destination_type == 'voicemail' %}
 same => n,Voicemail({{ route.destination_id }}@default,u)
{% elif route.destination_type == 'hangup' %}
 same => n,Hangup()
{% else %}
 same => n,Set(CALL_DIRECTION=external)
 same => n,Goto(ext-{{ route.destination_id }},s,1)
{% endif %}
 same => n,Hangup()
{% endfor %}
{% endfor %}
{% for condition in time_conditions %}
exten => {{ condition.did }},1,NoOp(Inbound (time): {{ condition.did }})
{% for holiday in holidays %}
; Holiday '{{ holiday.name }}' ({{ holiday.year }}) always wins over open_hours/open_days below.
; GotoIfTime has no year field, so the year is checked separately here -
; holidays are one-time dates, not automatically recurring (most shift
; year to year, e.g. Easter-based ones).
 same => n,GotoIf($["${YEAR}" != "{{ holiday.year }}"]?skip-holiday-{{ condition.id }}-{{ loop.index }})
 same => n,GotoIfTime(*|*|{{ holiday.day }}|{{ holiday.month_name }}?closed-{{ condition.id }},1,1)
 same => n(skip-holiday-{{ condition.id }}-{{ loop.index }}),NoOp()
{% endfor %}
 same => n,GotoIfTime({{ condition.open_hours_start }}-{{ condition.open_hours_end }}|*|*|{{ condition.open_days }}?open-{{ condition.id }},1,1:closed-{{ condition.id }},1,1)
{% endfor %}
{% if not routes and not time_conditions %}
; No inbound routes/time conditions - ring all enabled extensions, then hang up.
exten => _X.,1,NoOp(Inbound (fallback): ${EXTEN})
{% if all_ext_dial %} same => n,Dial({{ all_ext_dial }},30)
{% else %} same => n,Congestion()
{% endif %} same => n,Hangup()
exten => _+X.,1,NoOp(Inbound (fallback +): ${EXTEN})
{% if all_ext_dial %} same => n,Dial({{ all_ext_dial }},30)
{% else %} same => n,Congestion()
{% endif %} same => n,Hangup()
{% endif %}
