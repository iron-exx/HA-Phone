[closed-{{ condition.id }}]
{% if condition.closed_dest_type == 'ring_group' %}
{% if ring_group_dials.get(condition.closed_destination, '') %}
exten => 1,1,Dial({{ ring_group_dials.get(condition.closed_destination, '') }},30)
{% else %}
exten => 1,1,Congestion()
