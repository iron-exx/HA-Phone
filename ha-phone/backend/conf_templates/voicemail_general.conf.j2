; Auto-generated by HA-Phone — do not edit manually
; Voicemail [general] settings. mailcmd routes email through msmtp when SMTP is
; configured; otherwise mail is discarded (/bin/true) so no delivery errors occur.
[general]
format      = wav
attach      = yes
{% if enabled and from_addr %}
serveremail = {{ from_addr }}
fromstring  = {{ from_name }}
mailcmd     = /usr/bin/msmtp -C /data/asterisk/msmtprc -t
{% else %}
serveremail = pbx@ha-phone.local
mailcmd     = /bin/true
{% endif %}
